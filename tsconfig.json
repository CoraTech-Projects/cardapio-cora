{
  "compilerOptions": {
    "target": "ESNext",       
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "emitDeclarationOnly": false, 
    "noEmit": false,
    
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  }
}
